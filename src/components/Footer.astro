---
interface Props {
  site: {
    nome: string;
    nomeCurto: string;
    descricao: string;
    email: string;
    instagram: string | null;
    linkedin: string | null;
    facebook: string | null;
    youtube: string | null;
  };
}
const { site } = Astro.props;

const redes = [
  { label: 'Instagram', href: site.instagram },
  { label: 'LinkedIn', href: site.linkedin },
  { label: 'Facebook', href: site.facebook },
  { label: 'YouTube', href: site.youtube },
].filter((r) => r.href);

const paginas = [
  { href: '/equipa', label: 'Equipa' },
  { href: '/garagem', label: 'Garagem' },
  { href: '/noticias', label: 'Notícias' },
  { href: '/parceiros', label: 'Parceiros' },
  { href: '/contactos', label: 'Contactos' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__cta">
      <h2>Vamos construir o futuro a hidrogénio.</h2>
      <a class="btn" href={site.email ? `mailto:${site.email}` : '/contactos'}>Fala connosco</a>
    </div>

    <div class="footer__grid">
      <div>
        <strong class="footer__brand">{site.nomeCurto}</strong>
        {site.descricao && <p class="footer__desc">{site.descricao}</p>}
      </div>
      <div>
        <h3>Explorar</h3>
        <ul>
          {paginas.map((p) => (
            <li>
              <a href={p.href}>{p.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Contacto</h3>
        <ul>
          {site.email && (
            <li>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          )}
          <li>Instituto Superior Técnico</li>
          <li>Universidade de Lisboa</li>
        </ul>
      </div>
      {
        redes.length > 0 && (
          <div>
            <h3>Segue-nos</h3>
            <ul>
              {redes.map((r) => (
                <li>
                  <a href={r.href!} target="_blank" rel="noopener noreferrer">
                    {r.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} {site.nome}</span>
      <a href="#">Voltar ao topo ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--on-dark);
    padding-block: clamp(3.5rem, 8vw, 6rem) 2rem;
  }
  .footer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--dark-line);
  }
  .footer__cta h2 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 5vw, 3.6rem);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2rem;
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
  }
  .footer__brand {
    font-family: var(--font-display);
    font-size: 1.6rem;
  }
  .footer__desc {
    color: var(--on-dark-soft);
    max-width: 36ch;
    margin: 0.75rem 0 0;
  }
  .footer h3 {
    font-family: var(--font);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--on-dark-soft);
  }
  .footer a {
    color: var(--on-dark);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer ul a:hover,
  .footer__bottom a:hover {
    color: var(--accent);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--dark-line);
    font-size: 0.85rem;
    color: var(--on-dark-soft);
  }
  .footer__bottom a {
    color: var(--on-dark-soft);
  }
  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__grid > :first-child {
      grid-column: 1 / -1;
    }
  }
</style>

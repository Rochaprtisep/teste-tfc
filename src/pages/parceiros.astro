---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getDefinicoes, getParceiros, NIVEIS_PARCEIRO } from '../lib/content';

const site = await getDefinicoes();
const parceiros = await getParceiros();

const niveis = NIVEIS_PARCEIRO.map((n) => ({
  ...n,
  parceiros: parceiros
    .filter((p) => p.nivel === n.value)
    .sort((a, b) => (a.ordem ?? 10) - (b.ordem ?? 10) || a.nome.localeCompare(b.nome, 'pt')),
})).filter((n) => n.parceiros.length > 0);
---

<Base title="Parceiros" description="As empresas e instituições que tornam o nosso projeto possível.">
  <PageHeader eyebrow="Parceiros" title="Quem nos apoia" text="Sem os nossos parceiros, nada disto seria possível. Obrigado!" />

  <div class="container section">
    {niveis.length === 0 && <p class="empty">Ainda não há parceiros registados.</p>}
    {
      niveis.map((n) => (
        <section class={`tier tier--${n.value}`}>
          <h2 data-reveal>{n.title}</h2>
          <div class="logos" data-reveal style="--delay: 0.08s">
            {n.parceiros.map((p) => {
              const Tag = p.website ? 'a' : 'div';
              return (
                <Tag class="logo" href={p.website || undefined} target={p.website ? '_blank' : undefined} rel="noopener noreferrer" title={p.nome}>
                  {p.logo ? <img src={p.logo} alt={p.nome} loading="lazy" /> : <span>{p.nome}</span>}
                </Tag>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>

  <section class="section section--dark cta">
    <div class="container cta__inner" data-reveal>
      <div>
        <p class="eyebrow">Parcerias</p>
        <h2>Quer apoiar-nos?</h2>
        <p class="muted">Temos pacotes de parceria com visibilidade no protótipo, nas redes e nos eventos.</p>
      </div>
      <a class="btn" href={site.email ? `mailto:${site.email}?subject=Parceria` : '/contactos'}>Fale connosco</a>
    </div>
  </section>
</Base>

<style>
  .tier + .tier {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .tier h2 {
    font-size: 0.8rem;
    font-family: var(--font);
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--size, 200px), 1fr));
    padding: 0 1px 1px 0;
  }
  .tier--principal .logos {
    --size: 320px;
  }
  .tier--apoio .logos {
    --size: 160px;
  }
  .logo {
    border: 1px solid var(--line);
    margin: 0 -1px -1px 0;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    padding: 1.5rem;
    background: var(--bg);
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-align: center;
    transition: background 0.2s;
  }
  .tier--principal .logo {
    font-size: 1.5rem;
  }
  a.logo:hover {
    background: var(--bg-alt);
  }
  .logo img {
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .cta h2 {
    margin-bottom: 0.4em;
  }
  .cta p.muted {
    margin: 0;
    max-width: 50ch;
  }
</style>

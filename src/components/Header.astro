---
interface Props {
  site: { nome: string; nomeCurto: string; logo: string | null };
}
const { site } = Astro.props;

const links = [
  { href: '/', label: 'Início' },
  { href: '/equipa', label: 'Equipa' },
  { href: '/garagem', label: 'Garagem' },
  { href: '/noticias', label: 'Notícias' },
  { href: '/parceiros', label: 'Parceiros' },
  { href: '/contactos', label: 'Contactos' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={site.nome}>
      {site.logo ? <img src={site.logo} alt="" height="36" /> : null}
      <span>{site.nomeCurto}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-button" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </label>

    <nav aria-label="Navegação principal">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .brand img {
    height: 36px;
    width: auto;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--bg-alt);
  }
  nav a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .nav-toggle,
  .nav-button {
    display: none;
  }

  @media (max-width: 820px) {
    .nav-button {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 10px;
      cursor: pointer;
    }
    .nav-button span {
      width: 22px;
      height: 2px;
      background: var(--ink);
      border-radius: 2px;
      transition: transform 0.2s, opacity 0.2s;
    }
    nav {
      position: absolute;
      inset: 64px 0 auto 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      display: none;
    }
    nav ul {
      flex-direction: column;
      padding: 0.5rem 1rem 1rem;
    }
    nav a {
      border-radius: 10px;
      padding: 0.75rem 1rem;
    }
    .nav-toggle:checked ~ nav {
      display: block;
    }
    .nav-toggle:checked + .nav-button span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked + .nav-button span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked + .nav-button span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { getPrototipos, renderRico } from '../lib/content';

const prototipos = (await getPrototipos()).map((p) => ({ ...p, html: renderRico(p.descricao) }));
---

<Base title="Garagem" description="Os protótipos desenvolvidos pela equipa ao longo dos anos.">
  <div class="container page-header">
    <p class="eyebrow">Garagem</p>
    <h1>Os nossos protótipos</h1>
    <p>Do primeiro esboço à pista: os veículos que construímos ao longo dos anos.</p>
  </div>

  <div class="container">
    {prototipos.length === 0 && <p class="empty">Ainda não há protótipos registados.</p>}
    {
      prototipos.map((p) => (
        <article class="proto" id={p.slug}>
          <div class="proto__media">
            {p.imagem ? <img src={p.imagem} alt={p.nome} loading="lazy" /> : <div class="placeholder-img">{p.nome}</div>}
            {p.galeria.length > 0 && (
              <div class="gallery">
                {p.galeria.map((src) => (
                  <a href={src} target="_blank">
                    <img src={`${src}?w=400&h=400&fit=crop&auto=format`} alt="" loading="lazy" />
                  </a>
                ))}
              </div>
            )}
          </div>
          <div>
            <p class="eyebrow">{p.ano}</p>
            <h2>{p.nome}</h2>
            {p.resumo && <p class="lead">{p.resumo}</p>}
            {p.especificacoes.length > 0 && (
              <dl class="specs">
                {p.especificacoes.map((s) => (
                  <div>
                    <dt>{s.nome}</dt>
                    <dd>{s.valor}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="prose" set:html={p.html} />
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .proto {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .proto:last-child {
    border-bottom: 0;
  }
  .proto__media > img,
  .proto__media > .placeholder-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .gallery img {
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }
  .lead {
    font-size: 1.1rem;
    color: var(--ink-soft);
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .specs div {
    background: var(--bg-alt);
    border-radius: 10px;
    padding: 0.75rem 1rem;
  }
  .specs dt {
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .specs dd {
    margin: 0;
    font-weight: 700;
  }
  @media (max-width: 820px) {
    .proto {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getNoticias } from '../../lib/content';

const noticias = await getNoticias();
---

<Base title="Notícias" description="Novidades, competições e eventos da equipa.">
  <PageHeader eyebrow="Notícias" title="O que temos feito" text="Competições, eventos, testes e tudo o que acontece na equipa." />

  <div class="container section">
    {noticias.length === 0 && <p class="empty">Ainda não há notícias publicadas.</p>}
    <div class="grid">
      {
        noticias.map((n, i) => (
          <div data-reveal style={`--delay: ${(i % 3) * 0.08}s`}>
            <NewsCard {...n} />
          </div>
        ))
      }
    </div>
  </div>
</Base>

# Copiar para .env (nunca fazer commit do .env).
# Estes valores são gerados automaticamente pelo assistente do Keystatic
# quando se cria a GitHub App (ver README).

# Pôr a true para testar o painel em modo GitHub com `npm run dev`
PUBLIC_KEYSTATIC_GITHUB=false

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <div class="container page-header" style="text-align: center; padding-block: 6rem">
    <p class="eyebrow">Erro 404</p>
    <h1>Esta página não existe</h1>
    <p style="margin-inline: auto">Pode ter sido movida ou removida.</p>
    <p style="margin-top: 2rem"><a class="btn" href="/">Voltar ao início</a></p>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import { getNoticias, renderRico, formatDate, type Noticia } from '../../lib/content';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  return noticias.map((noticia) => ({ params: { slug: noticia.slug }, props: { noticia } }));
}

const { noticia } = Astro.props as { noticia: Noticia };
const html = renderRico(noticia.conteudo);
---

<Base title={noticia.titulo} description={noticia.resumo} image={noticia.capa}>
  <header class="page-header">
    <div class="container article-head">
      <a href="/noticias" class="back">← Todas as notícias</a>
      <time class="eyebrow" datetime={noticia.data}>{formatDate(noticia.data)}</time>
      <h1>{noticia.titulo}</h1>
      {noticia.resumo && <p>{noticia.resumo}</p>}
    </div>
  </header>

  <article class="container article">
    {noticia.capa && <img class="cover" src={noticia.capa} alt="" />}
    <div class="prose" set:html={html} />
  </article>
</Base>

<style>
  .article-head {
    max-width: 860px;
  }
  .article-head h1 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
  }
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--on-dark-soft);
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }
  .back:hover {
    color: var(--accent);
  }
  .eyebrow {
    display: flex;
  }
  .article {
    max-width: 860px;
    padding-block: 0 clamp(3rem, 8vw, 5rem);
  }
  .cover {
    width: 100%;
    border-radius: var(--radius);
    margin-top: clamp(-2rem, -3vw, -1rem);
    position: relative;
    margin-bottom: 2.5rem;
  }
  .prose {
    padding-top: 2.5rem;
  }
  .cover + .prose {
    padding-top: 0;
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getDefinicoes, getContactos } from '../lib/content';

const site = await getDefinicoes();
const c = await getContactos();

const redes = [
  { label: 'Instagram', href: site.instagram },
  { label: 'LinkedIn', href: site.linkedin },
  { label: 'Facebook', href: site.facebook },
  { label: 'YouTube', href: site.youtube },
].filter((r) => r.href);
---

<Base title="Contactos" description={`Como entrar em contacto com a ${site.nomeCurto}.`}>
  <PageHeader eyebrow="Contactos" title="Fala connosco" text={c.introducao} />

  <div class="container section">
    <div class="boxes">
      {
        site.email && (
          <div class="box" data-reveal>
            <h2>Email</h2>
            <a class="box__main" href={`mailto:${site.email}`}>
              {site.email}
            </a>
            {c.contactosExtra.length > 0 && (
              <ul>
                {c.contactosExtra.map((x) => (
                  <li>
                    <span class="muted">{x.area}</span>
                    <a href={`mailto:${x.email}`}>{x.email}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
      {
        c.morada && (
          <div class="box" data-reveal style="--delay: 0.08s">
            <h2>Onde estamos</h2>
            <p class="box__main" style="white-space: pre-line">
              {c.morada}
            </p>
            {c.mapaUrl && (
              <a class="link-arrow" href={c.mapaUrl} target="_blank" rel="noopener noreferrer">
                Ver no mapa
              </a>
            )}
          </div>
        )
      }
      {
        redes.length > 0 && (
          <div class="box" data-reveal style="--delay: 0.16s">
            <h2>Redes sociais</h2>
            <ul>
              {redes.map((r) => (
                <li>
                  <a class="box__social" href={r.href!} target="_blank" rel="noopener noreferrer">
                    {r.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</Base>

<style>
  .boxes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    padding: 0 1px 1px 0;
  }
  .box {
    border: 1px solid var(--line);
    margin: 0 -1px -1px 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .box h2 {
    font-family: var(--font);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--accent-strong);
    margin: 0;
  }
  .box__main {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    margin: 0;
    word-break: break-word;
  }
  a.box__main:hover {
    color: var(--accent-strong);
  }
  .box ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
  }
  .box li {
    display: flex;
    flex-direction: column;
  }
  .box li .muted {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .box__social {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .box__social:hover {
    color: var(--accent-strong);
  }
</style>

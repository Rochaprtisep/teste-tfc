---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPrototipos, renderRico } from '../lib/content';

const prototipos = (await getPrototipos()).map((p) => ({ ...p, html: renderRico(p.descricao) }));
---

<Base title="Garagem" description="Os protótipos desenvolvidos pela equipa ao longo dos anos.">
  <PageHeader eyebrow="Garagem" title="Os nossos protótipos" text="Do primeiro esboço à pista: os veículos que construímos ao longo dos anos.">
    {
      prototipos.length > 1 && (
        <nav class="years" aria-label="Protótipos" data-reveal style="--delay: 0.18s">
          {prototipos.map((p) => (
            <a href={`#${p.slug}`}>
              <strong>{p.ano}</strong> {p.nome}
            </a>
          ))}
        </nav>
      )
    }
  </PageHeader>

  <div class="container section">
    {prototipos.length === 0 && <p class="empty">Ainda não há protótipos registados.</p>}
    {
      prototipos.map((p) => (
        <article class="proto" id={p.slug}>
          <div class="proto__media" data-reveal>
            {p.imagem ? <img src={p.imagem} alt={p.nome} loading="lazy" /> : <div class="placeholder-img">{p.nome}</div>}
            {p.galeria.length > 0 && (
              <div class="gallery">
                {p.galeria.map((src) => (
                  <a href={src} target="_blank">
                    <img src={`${src}?w=400&h=400&fit=crop&auto=format`} alt="" loading="lazy" />
                  </a>
                ))}
              </div>
            )}
          </div>
          <div data-reveal style="--delay: 0.1s">
            <p class="proto__year">{p.ano}</p>
            <h2>{p.nome}</h2>
            {p.resumo && <p class="lead">{p.resumo}</p>}
            {p.especificacoes.length > 0 && (
              <dl class="specs">
                {p.especificacoes.map((s) => (
                  <div>
                    <dt>{s.nome}</dt>
                    <dd>{s.valor}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="prose" set:html={p.html} />
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .years a {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--dark-line);
    border-radius: 999px;
    color: var(--on-dark);
    text-decoration: none;
    font-size: 0.85rem;
    transition: border-color 0.2s;
  }
  .years a:hover {
    border-color: var(--accent);
  }
  .years strong {
    color: var(--accent);
  }
  .proto {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .proto + .proto {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .proto:nth-child(even) .proto__media {
    order: 2;
  }
  .proto__media > img,
  .proto__media > .placeholder-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .gallery a {
    overflow: hidden;
    border-radius: var(--radius);
  }
  .gallery img {
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .gallery a:hover img {
    transform: scale(1.08);
  }
  .proto__year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
    margin: 0 0 0.5rem;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    margin: 2rem 0;
    padding: 0 1px 1px 0;
  }
  .specs div {
    border: 1px solid var(--line);
    margin: 0 -1px -1px 0;
    padding: 1rem 1.1rem;
  }
  .specs dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
  }
  .specs dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .proto {
      grid-template-columns: 1fr;
    }
    .proto:nth-child(even) .proto__media {
      order: 0;
    }
  }
</style>
